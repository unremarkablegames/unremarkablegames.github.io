-- GET FROM CONTAINER ROOM
-- =============================================================================

function facilitator_container_greet(ctx)
	say(ctx.mob, "Hello. Facilitator Signe here. Take the sword and cap from the chest.")
	hint("Items can be taken from containers. You can use two different commands for this, from and get. Try &!&efrom chest get sword&g&* and &!&eget cap chest&g&*.")
end

function tutorial_sword_pickup(ctx)
	local room = get_room("tutorial.room.container")
	set_room_flag(room, 0)
	if get_room_flag(room, 1) then
		local facilitator = find_mob("tutorial.mob.facilitator_container")
		if facilitator and mob_in_room(facilitator, room) then
			emote(facilitator, "%s nods, unlocks, and opens the gate.")
		end
		unlock_door(room, "north")
		open_door(room, "north")
	end
end

