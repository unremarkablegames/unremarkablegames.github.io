desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center."""

	[area.room.exits]
	north = { to = ".room.quest", door = ".door.gate" }
	south = { to = ".room.score", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_skills"

# --- QUEST ---
[[area.room]]
id = ".room.quest"
name = "Indoc Quest Evaluation"
command_prog = "tutorial_quest_command"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center."""

	[area.room.exits]
	north = { to = ".room.targeting", door = ".door.gate" }
	south = { to = ".room.skills", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_quest"

# --- TARGETING ---
[[area.room]]
id = ".room.targeting"
name = "Indoc Targeting Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center."""

	[area.room.exits]
	north = { to = ".room.help", door = ".door.gate" }
	south = { to = ".room.quest", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_target"

	[[area.room.resets.item]]
	proto = ".item.sign_first"

	[[area.room.resets.item]]
	proto = ".item.sign_second"

# --- HELP ---
[[area.room]]
id = ".room.help"
name = "Indoc Help Evaluation"
command_prog = "tutorial_help_command"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center."""

	[area.room.exits]
	north = { to = ".room.threshold", door = ".door.gate" }
	south = { to = ".room.targeting", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_help"

# --- THRESHOLD ---
[[area.room]]
id = ".room.threshold"
name = "Indoc Completion"
can_leave_prog = "threshold_exit"
desc = """There is a circle painted on the floor in red paint. "COMPLETE" has been stenciled in the center with an arrow pointing north."""

	[area.room.exits]
	north = ".room.void"
	south = { to = ".room.help", door = ".door.gate" }

# --- VOID ---
[[area.room]]
id = ".room.void"
name = "Keth's Office"
desc = """A small home office. White shiplap walls, a window with the blinds shut. A wheeled cart overflowing with colored pencils, a guitar on a stand, a butcherblock worktable with a soldering iron and a perfboard with wires splaying everywhere like a giant insect. The desk has two wide monitors next to a black and white cat sleeping on a laptop. Four framed prints hang on the wall. A space heater hums near a well-worn office chair. RGB strips along the ceiling wash everything in soft color."""

	[[area.room.extra_desc]]
	keywords = "framed prints"
	desc = "Each print is the size of a hand. Scot's Adventure Racing, Neon Labyrinth, Brinebound, and Voidstone."

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.keth"

# ==============================================================================
# DOORS
# ==============================================================================

[[area.door]]
id = ".door.gate"
keywords = "gate iron"
name = "iron gate"
short = "an iron gate"
desc = "Heavy iron bars with a large lock mechanism."
lockable = true
locked = true

[[area.door]]
id = ".door.open"
keywords = "door wooden heavy"
name = "wooden door"
short = "a heavy wooden door"
desc = "Heavy oak, iron-banded. The hinges are well-oiled."
lockable = false
locked = false
open_prog = "facilitator_open_gate"

[[area.door]]
id = ".door.unlock"
keywords = "door iron"
name = "iron door"
short = "an iron door"
desc = "Iron-banded oak. The keyhole is dark and waiting."
lockable = true
locked = true
key = ".item.brass_key"
open_prog = "facilitator_unlock_gate"

[[area.door]]
id = ".door.closet"
keywords = "door closet wooden"
name = "closet door"
short = "a closet door"
desc = "Thin pine, warped from moisture. The latch barely catches."
lockable = false
open = true
close_prog = "facilitator_close_gate"

# ==============================================================================
# QUESTS
# ==============================================================================

[[area.quest]]
id = ".main.proving"
name = "The Proving"
type = "main"
summary = "Complete the evaluation circuit to qualify for Awakening."
