[area]
id = "induction"
name = "Awakening Cells"
safe_room = "induction.room.cell_s"

# ==============================================================================
# ITEMS
# ==============================================================================

[[area.item]]
id = ".item.brass_key"
type = "key"
keywords = "key brass heavy"
short = "a heavy brass key"
long = "A heavy brass key lies here."
desc = "Brass, worn smooth at the grip. The bow is stamped with a number, long since rubbed illegible."

[[area.item]]
id = ".item.linen_shirt"
type = "clothing.shirt"
keywords = "shirt linen undershirt"
short = "a linen shirt"
long = "A linen shirt lies here."
desc = "Plain linen, worn soft from washing. Standard issue undergarment."

[[area.item]]
id = ".item.wool_trousers"
type = "clothing.pants"
keywords = "trousers pants wool"
short = "a pair of wool trousers"
long = "A pair of wool trousers lies here."
desc = "Sturdy wool trousers. The knees are reinforced."

[[area.item]]
id = ".item.leather_cap"
type = "armor.leather.head"
keywords = "cap leather boiled"
short = "a boiled leather cap"
long = "A boiled leather cap lies here."
desc = "A simple cap of boiled leather. The inside band is sweat-stained."

[[area.item]]
id = ".item.leather_spaulders"
type = "armor.leather.shoulders"
keywords = "spaulders shoulders leather boiled"
short = "a pair of boiled leather spaulders"
long = "A pair of boiled leather spaulders lies here."
desc = "Hardened leather shoulder guards. The straps are frayed at the buckles."

[[area.item]]
id = ".item.leather_cuirass"
type = "armor.leather.chest"
keywords = "cuirass armor leather boiled chest"
short = "a boiled leather cuirass"
long = "A boiled leather cuirass lies here."
desc = "Hardened leather shaped to the torso. It smells of neatsfoot oil."

[[area.item]]
id = ".item.leather_bracers"
type = "armor.leather.arms"
keywords = "bracers leather boiled arms"
short = "a pair of boiled leather bracers"
long = "A pair of boiled leather bracers lies here."
desc = "Forearm guards of stiffened leather. The left one bears a deep gouge."

[[area.item]]
id = ".item.leather_gloves"
type = "armor.leather.hands"
keywords = "gloves leather boiled hands"
short = "a pair of boiled leather gloves"
long = "A pair of boiled leather gloves lies here."
desc = "Thick leather gloves, fingers reinforced. The palms are worn smooth."

[[area.item]]
id = ".item.leather_greaves"
type = "armor.leather.legs"
keywords = "greaves leather boiled legs"
short = "a pair of boiled leather greaves"
long = "A pair of boiled leather greaves lies here."
desc = "Hardened leather leg armor. Scuffed at the knees."

[[area.item]]
id = ".item.leather_boots"
type = "armor.leather.feet"
keywords = "boots leather boiled feet"
short = "a pair of boiled leather boots"
long = "A pair of boiled leather boots lies here."
desc = "Sturdy boots with hardened leather uppers. The soles are worn thin."

[[area.item]]
id = ".item.leather_belt"
type = "clothing.waist"
keywords = "belt leather waist"
short = "a leather belt"
long = "A leather belt lies here."
desc = "A simple leather belt with an iron buckle."

[[area.item]]
id = ".item.canvas_cloak"
type = "clothing.back"
keywords = "cloak canvas oiled back"
short = "an oiled canvas cloak"
long = "An oiled canvas cloak lies here."
desc = "Heavy canvas treated with oil. Repels water and wind. Smells faintly of linseed."

[[area.item]]
id = ".item.issue_rucksack"
type = "container"
keywords = "sack rucksack canvas"
short = "a canvas rucksack"
long = "A canvas rucksack slumps against the wall."
desc = "Standard issue. The canvas is stiff, the buckles still bright."
weight = "3lb"
capacity = "40lb"
closeable = true

[[area.item]]
id = ".item.guard_spear"
type = "weapon.spear"
keywords = "spear pike weapon"
short = "a heavy wooden spear"
long = "A heavy wooden spear leans against the wall."
desc = "A heavy wooden spear with an oak shaft and sharpened steel head."
attack_verbs = ["thrust", "jab", "stab"]

[[area.item]]
id = ".item.guard_sword"
type = "weapon.short_sword"
keywords = "stonewatcher short sword"
short = "a short sword"
long = "A short sword bearing the insignia of the stonewatcher guard lies here."
desc = "A short sword, well oiled with a leather pommel. The hilt bears the insignia of the stonewatcher guard."
attack_verbs = ["parry", "lunge", "thrust", "cut"]

[[area.item]]
id = ".item.guard_corpse"
type = "container"
capacity = "5st"
closeable = false
keywords = "corpse body guard"
short = "a guard's corpse"
long = "The corpse of a cell guard lies crumpled against the wall."
desc = "A cell guard, dead perhaps an hour. His throat has been torn out with teeth. His hand is still on the key ring. His eyes are open, fixed on nothing."
weight = "14st 8lb"

[[area.item]]
id = ".item.candidate_corpse"
keywords = "corpse naked"
short = "a naked corpse"
long = "A naked corpse lies face-down on the stone floor."
desc = "A gaunt man, young, covered in blood. Multiple spear wounds. His face is frozen mid-scream, but his eyes are calm. Wrong."
weight = "11st 9lb"

# ==============================================================================
# MOBS
# ==============================================================================

[[area.mob]]
id = ".mob.guard_lead"
keywords = "guard cell stocky"
short = "a cell guard"
long = "A stocky cell guard stands here, clipboard in hand."
desc = "Stocky, tired eyes. His gaze slides past you without lingering."
creature_type = "humanoid"
weight = "13st"
str = 30
dex = 30
int = 20
swordsmanship = 40
fencing = 30
wrestling = 10
tactics = 20
anatomy = 30
tick_prog = "waking_cell_tick"
money = { min = 24, max = 72 }
equipment = [
    ".item.linen_shirt",
    ".item.wool_trousers",
    ".item.leather_cap",
    ".item.leather_spaulders",
    ".item.leather_cuirass",
    ".item.leather_bracers",
    ".item.leather_gloves",
    ".item.leather_greaves",
    ".item.leather_boots",
    ".item.leather_belt",
    ".item.guard_spear",
    ".item.brass_key"
]

[[area.mob.action]]
id = "idle"
emotes = ["flips a page on his clipboard.", "stifles a yawn.", "taps a pen against the clipboard."]
interval = { min = 25, max = 45 }
	[[area.mob.action.consideration]]
	fn = "always"
	params = []

[[area.mob]]
id = ".mob.guard"
keywords = "stonewatcher guard"
short = "a stonewatcher guard"
long = "A member of the stonewatcher guard stands here."
desc = "Stocky, tired eyes. His gaze slides past you without lingering."
creature_type = "humanoid"
weight = "12st"
str = 24
dex = 28
int = 22
swordsmanship = 30
fencing = 30
wrestling = 20
tactics = 30
anatomy = 30
money = { min = 14, max = 32 }
equipment = [
    ".item.linen_shirt",
    ".item.wool_trousers",
    ".item.leather_cap",
    ".item.leather_spaulders",
    ".item.leather_cuirass",
    ".item.leather_bracers",
    ".item.leather_gloves",
    ".item.leather_greaves",
    ".item.leather_boots",
    ".item.leather_belt",
    ".item.guard_sword"
]


[[area.mob.action]]
id = "idle"
emotes = ["examines you.", "stifles a yawn."]
interval = { min = 25, max = 45 }
	[[area.mob.action.consideration]]
	fn = "always"
	params = []

[[area.mob]]
id = ".mob.quartermaster"
base = ".mob.guard"
keywords = "quartermaster clerk supply"
short = "a grizzled quartermaster"
long = "A grizzled quartermaster sits behind the desk, scratching notes."
desc = "Old soldier gone to desk duty. Ink-stained fingers, calculating eyes."

[[area.mob]]
id = ".mob.sewer_rat"
keywords = "rat sewer large"
short = "a large sewer rat"
long = "A slick-coated rat watches you, unafraid."
desc = "Bigger than a cat. Its fur is matted and greasy. No fear in those black eyes."
creature_type = "animal"
weight = "2lb 4oz"
str = 2
dex = 4
int = 1
size = "tiny"
diet = "omnivore"
food_type = "meat"
[area.mob.traits]
curiosity = 40
courage = 30
reaction = 10

[[area.mob.action]]
id = "flee"
	[[area.mob.action.consideration]]
	fn = "less_than"
	params = ["self.hp_pct", "inv.trait.courage"]
	[[area.mob.action.consideration]]
	fn = "has_memory"
	params = ["saw_ally_die", "target"]

[[area.mob.action]]
id = "attack"
	[[area.mob.action.consideration]]
	fn = "has_memory"
	params = ["damaged_by", "target"]
	[[area.mob.action.consideration]]
	fn = "is_hostile"
	params = ["self.faction", "target.faction"]

[[area.mob.action]]
id = "wander"
	[[area.mob.action.consideration]]
	fn = "greater_than"
	params = ["self.ticks_in_room", "inv.trait.curiosity"]

[[area.mob.action]]
id = "idle"
emotes = ["sniffs the air.", "finds a disgusting snack and nibbles on it.", "glares at you."]
interval = { min = 10, max = 60 }
	[[area.mob.action.consideration]]
	fn = "always"
	params = []

