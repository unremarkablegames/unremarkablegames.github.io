# ==============================================================================
# QUESTS
# ==============================================================================

[[area.quest]]
id = ".main.awakening"
name = "Awakening"
type = "main"
summary = "You woke in the cells beneath the Keep. Time to find out what comes next."
[area]
id = "tutorial"
name = "The Proving"
safe_room = "tutorial.room.movement"

# ==============================================================================
# ITEMS
# ==============================================================================

[[area.item]]
id = ".item.candle"
keywords = "candle tallow wax"
short = "a tallow candle"
long = "A tallow candle lies here."
desc = "Cheap tallow, half-burned. The wick is black and curled."
weight = "4oz"
pickup_prog = "tutorial_candle_pickup"

[[area.item]]
id = ".item.marker"
keywords = "mark marker red paint"
short = "a red mark"
long = "A red mark has been painted on the eastern wall."
desc = "A smear of red paint, the size of a hand. It has been repainted many times, the layers showing at the edges."
weight = "0oz"
fixed = true
look_prog = "tutorial_marker_look"

[[area.item]]
id = ".item.brass_key"
type = "key"
keywords = "key brass"
short = "a brass key"
long = "A brass key lies on the ground."
desc = "Simple brass, warm from the stone. The teeth are worn smooth from use."

[[area.item]]
id = ".item.training_chest"
type = "container"
keywords = "chest open"
short = "an open chest"
long = "An open chest sits on a low table."
desc = "Iron hinges, brass fittings. The inside is lined with felt worn thin from whatever used to be stored here. A keyhole gleams in the front clasp."
weight = "20lb"
capacity = "50lb"
fixed = true
lockable = true
locked = false
key = ".item.brass_key"

[[area.item]]
id = ".item.equipment_chest"
type = "container"
keywords = "chest wooden"
short = "a wooden chest"
long = "A wooden chest sits open against the wall."
desc = "Sturdy pine, iron-cornered. The inside smells of sawdust and the faint ghost of whatever oil they use on the blades."
weight = "15lb"
capacity = "40lb"
fixed = true
closeable = false

[[area.item]]
id = ".item.training_sword"
type = "weapon.short_sword"
keywords = "sword training"
short = "a training sword"
long = "A training sword rests here."
desc = "The edge has been dulled for safety, though not so much that it couldn't cut if you swung hard enough. The hilt is wrapped in leather darkened by other hands."
pickup_prog = "tutorial_sword_pickup"
wear_prog = "tutorial_sword_equip"

[[area.item]]
id = ".item.leather_cap"
type = "armor.leather.head"
keywords = "cap leather"
short = "a leather cap"
long = "A leather cap rests here."
desc = "Hardened leather, softened by use. It smells of other people's sweat. The padding inside has been replaced more than once."
pickup_prog = "tutorial_cap_pickup"
wear_prog = "tutorial_cap_equip"

[[area.item]]
id = ".item.sign_first"
keywords = "sign wooden"
short = "a wooden sign"
long = "A wooden sign hangs on the wall."
desc = "It reads: 'This is the first sign.'"
weight = "0oz"
fixed = true

[[area.item]]
id = ".item.sign_second"
keywords = "sign wooden"
short = "a wooden sign"
long = "A wooden sign hangs on the wall."
desc = "It reads: 'This is the second sign.'"
weight = "0oz"
fixed = true
look_prog = "tutorial_second_sign_look"

# ==============================================================================
# MOBS: Facilitators
# ==============================================================================

[[area.mob]]
id = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator stands here."
desc = "Keep staff. The scars have faded. The knuckles haven't."
creature_type = "humanoid"
weight = "10st"
str = 30
dex = 30
int = 30
wrestling = 40

[[area.mob]]
id = ".mob.facilitator_look"
base = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator in Keep leathers sits on a chair, arms crossed."
desc = "Lines at the corners of her eyes. Her hands haven't moved since you entered."
weight = "10st"
player_enter_prog = "facilitator_look_greet"

[[area.mob]]
id = ".mob.facilitator_say"
base = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator in Keep leathers sits on a stool, watching you."
desc = "Narrow face, narrow eyes. A thin scar bisects one eyebrow. She looks like she's deciding whether you're worth the trouble."
weight = "9st"
player_enter_prog = "facilitator_say_greet"
speech_prog = "facilitator_say_speech"

[[area.mob]]
id = ".mob.facilitator_inventory"
base = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator in Keep leathers stands here."
desc = "Patchy beard, bitten nails. He's already looking past you at the door."
weight = "10st"
player_enter_prog = "facilitator_inventory_greet"

[[area.mob]]
id = ".mob.facilitator_get"
base = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator in Keep leathers waits here."
desc = "Broad shoulders, soft hands. He's never done a day's real work."
weight = "11st"
player_enter_prog = "facilitator_get_greet"

[[area.mob]]
id = ".mob.facilitator_drop"
base = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator in Keep leathers stands by the north exit."
desc = "Thin-lipped. Her fingers drum against her thigh. They haven't stopped."
weight = "9st"
player_enter_prog = "facilitator_drop_greet"

[[area.mob]]
id = ".mob.facilitator_open"
base = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator in Keep leathers stands against the wall."
desc = "A burn scar runs from her jaw to her collar. She doesn't seem to notice you noticing."
weight = "9st"
player_enter_prog = "facilitator_open_greet"

[[area.mob]]
id = ".mob.facilitator_close"
base = ".mob.facilitator_base"
keywords = "facilitator stocky"
short = "a stocky facilitator"
long = "A stocky facilitator leans on a mop handle, blocking the closet door."
desc = "Rough hands, rougher face. He smells faintly of soap and pipe tobacco."
weight = "12st"
player_enter_prog = "facilitator_close_greet"

[[area.mob]]
id = ".mob.facilitator_unlock"
base = ".mob.facilitator_base"
keywords = "older facilitator"
short = "an older facilitator"
long = "An older facilitator in Keep leathers sits on a stool."
desc = "He doesn't look up when you enter. He's seen enough candidates."
weight = "12st"
player_enter_prog = "facilitator_unlock_greet"

[[area.mob]]
id = ".mob.facilitator_lock"
base = ".mob.facilitator_base"
keywords = "facilitator muscular"
short = "a muscular facilitator"
long = "A muscular facilitator stands by the north door, arms folded."
desc = "His sleeves strain at the seams. He hasn't looked at the crates."
weight = "15st"
player_enter_prog = "facilitator_lock_greet"

[[area.mob]]
id = ".mob.facilitator_container"
base = ".mob.facilitator_base"
keywords = "wiry facilitator"
short = "a wiry facilitator"
long = "A wiry facilitator leans in the doorway, picking at her nails."
desc = "She glances up, then back to her nails. A small knife catches the light between her fingers."
weight = "8st"
player_enter_prog = "facilitator_container_greet"

[[area.mob]]
id = ".mob.facilitator_equip"
base = ".mob.facilitator_base"
keywords = "scarred facilitator"
short = "a scarred facilitator"
long = "A scarred facilitator checks a list by the north door."
desc = "Old wounds across her arms. She survived what comes next."
weight = "10st"
player_enter_prog = "facilitator_equip_greet"

[[area.mob]]
id = ".mob.facilitator_recovery"
base = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator sits on a stool by the door."
desc = "Shoulders curved, chin down. The mug in her hands has gone cold."
weight = "9st"
player_enter_prog = "facilitator_recovery_greet"

[[area.mob]]
id = ".mob.facilitator_attack"
base = ".mob.facilitator_base"
keywords = "thick-armed facilitator"
short = "a thick-armed facilitator"
long = "A thick-armed facilitator leans against the wall."
desc = "He watches your hands. He sniffs once."
weight = "14st"
player_enter_prog = "facilitator_attack_greet"

[[area.mob]]
id = ".mob.facilitator_flee"
base = ".mob.facilitator_base"
keywords = "lean facilitator"
short = "a lean facilitator"
long = "A lean facilitator watches from the doorway."
desc = "Her eyes flick to the exits and back. Three fingers missing on her left, the stumps smooth and old."
weight = "9st"
player_enter_prog = "facilitator_flee_greet"

[[area.mob]]
id = ".mob.facilitator_score"
base = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator in Keep leathers waits with a wax tablet."
desc = "Freckled. Unsmiling. She holds her stylus like a knife."
weight = "10st"
player_enter_prog = "facilitator_score_greet"

[[area.mob]]
id = ".mob.facilitator_skills"
base = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator sits at a thin desk."
desc = "Balding. Spectacles perched on a crooked nose. Ink stains on his cuffs."
weight = "10st"
player_enter_prog = "facilitator_skills_greet"

[[area.mob]]
id = ".mob.facilitator_quest"
base = ".mob.facilitator_base"
keywords = "tired-looking facilitator"
short = "a tired facilitator"
long = "A tired-looking facilitator sits at a table, shuffling documents."
desc = "The ink on his documents has smeared past reading. He keeps writing anyway."
weight = "11st"
player_enter_prog = "facilitator_quest_greet"

[[area.mob]]
id = ".mob.facilitator_target"
base = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator stands by the north door, one eyebrow raised."
desc = "Sharp eyes, sharper smile. A gold tooth catches the light when she grins."
weight = "9st"
player_enter_prog = "facilitator_target_greet"

[[area.mob]]
id = ".mob.facilitator_help"
base = ".mob.facilitator_base"
keywords = "facilitator"
short = "a facilitator"
long = "A facilitator sits at a small desk, a closed book before her."
desc = "Gray streaks in her hair. Ink stains on her fingers. She hums tunelessly under her breath."
weight = "9st"
player_enter_prog = "facilitator_help_greet"

[[area.mob]]
id = ".mob.facilitator_induction"
base = ".mob.facilitator_base"
keywords = "burly facilitator"
short = "a burly facilitator"
long = "A burly facilitator stands here, guarding the southern exit."
desc = "Gray at the temples. Tattoos wind up both arms. Old ink, blurred by time and sun."
weight = "12st"

[[area.mob]]
id = ".mob.keth"
keywords = "keth man"
short = "Keth"
long = "A man in a hoodie stands here, hands in his pockets, smiling."
desc = "Jeans, hoodie, an Unremarkable Games shirt. Bags under his eyes, but he's smiling."
creature_type = "humanoid"
weight = "11st"
player_enter_prog = "keth_void_greet"

# ==============================================================================
# MOBS: Training Dummies
# ==============================================================================

[[area.mob]]
id = ".mob.training_dummy"
keywords = "dummy post training wooden"
short = "a training dummy"
long = "A training dummy stands here, scarred from countless strikes."
desc = "Rope-wrapped. Splintered. It fights back."
creature_type = "construct"
weight = "5st"
unkillable = true

[[area.mob]]
id = ".mob.training_dummy_flee"
keywords = "dummy training"
short = "a training dummy"
long = "A training dummy stands here, heavily patched."
desc = "Canvas and straw, stitched and restitched. The face is just a suggestion, two dark patches where eyes might be. It doesn't judge you for running. Nothing here does."
creature_type = "construct"
weight = "3st"
unkillable = true

# ==============================================================================
# ROOMS
# ==============================================================================

[[area.room]]
id = ".room.error"
name = "ERROR!"
desc = """You aren't supposed to be here..."""

# --- MOVEMENT ---
[[area.room]]
id = ".room.movement"
name = "Indoc Entry"
player_enter_prog = "tutorial_movement_enter"
can_leave_prog = "facilitator_enter_block"
desc = """The walls are stone, worn smooth where countless hands have steadied themselves. There is a door to the south with sunlight streaming in. A draft pulls north, carrying the faint smell of iron and old sweat. The northern door leads you deeper into the building."""

	[area.room.exits]
	north = ".room.look"
	south = ".room.error"

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_induction"

# --- LOOK ---
[[area.room]]
id = ".room.look"
name = "Indoc Observation Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. You have to edge past the facilitator's knees to reach it and your back brushes against the wall as you stand. There is a mark directly opposite you, over the facilitator's head."""

	[[area.room.extra_desc]]
	keywords = "mark"
	desc = "A worn scratch in the stone, about head height. Countless inductees have stared at this spot."

	[[area.room.extra_desc]]
	keywords = "circle paint floor"
	desc = "The red paint is faded and cracked. Boot prints have scuffed away parts of the lettering."

	[area.room.exits]
	north = { to = ".room.say", door = ".door.gate" }
	south = ".room.movement"

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_look"

	[[area.room.resets.item]]
	proto = ".item.marker"

# --- SAY ---
[[area.room]]
id = ".room.say"
name = "Indoc Speaking Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. An oil lantern gutters on the wall."""

	[area.room.exits]
	north = { to = ".room.get", door = ".door.gate" }
	south = { to = ".room.look", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_say"

# --- GET ---
[[area.room]]
id = ".room.get"
name = "Indoc Get Item Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. There is another circle painted next to it in blue with a stenciled "CANDLE" in it."""

	[area.room.exits]
	north = { to = ".room.inventory", door = ".door.gate" }
	south = { to = ".room.say", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_get"

	[[area.room.resets.item]]
	proto = ".item.candle"

# --- INVENTORY ---
[[area.room]]
id = ".room.inventory"
name = "Indoc Inventory Evaluation"
command_prog = "tutorial_inventory_command"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. Grey light filters in through a slit window, high on the stone wall."""

	[area.room.exits]
	north = { to = ".room.drop", door = ".door.gate" }
	south = { to = ".room.get", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_inventory"

# --- DROP ---
[[area.room]]
id = ".room.drop"
name = "Indoc Put Item Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. There is another circle painted next to it in blue with a stenciled "CANDLE" in it."""
drop_prog = "tutorial_drop_room"

	[area.room.exits]
	north = { to = ".room.open", door = ".door.gate" }
	south = { to = ".room.inventory", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_drop"

# --- OPEN ---
[[area.room]]
id = ".room.open"
name = "Indoc Open Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. There is an arrow pointing to the north door with "OPEN" stenciled next to it."""
can_leave_prog = "facilitator_open_gate"

	[area.room.exits]
	north = { to = ".room.close", door = ".door.open" }
	south = { to = ".room.drop", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_open"

# --- CLOSE ---
[[area.room]]
id = ".room.close"
name = "Indoc Close Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. There is an arrow pointing west toward a broom closet with "CLOSE" stenciled next to it."""

	[area.room.exits]
	north = { to = ".room.unlock", door = ".door.gate" }
	south = { to = ".room.open", door = ".door.open" }
	west = { to = ".room.closet", door = ".door.closet" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_close"

# --- CLOSET ---
[[area.room]]
id = ".room.closet"
name = "Broom Closet"
desc = """A mop leans in the corner, its head gray with use. The air tastes of lye. On the back wall, someone has scratched a stick figure with too many arms."""

	[area.room.exits]
	east = { to = ".room.close", door = ".door.closet" }

# --- UNLOCK ---
[[area.room]]
id = ".room.unlock"
name = "Indoc Unlock Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. There is an arrow pointing to the north door with "UNLOCK" stenciled next to it."""

	[area.room.exits]
	north = { to = ".room.lock", door = ".door.unlock" }
	south = { to = ".room.close", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_unlock"

	[[area.room.resets.item]]
	proto = ".item.brass_key"

# --- LOCK ---
[[area.room]]
id = ".room.lock"
name = "Indoc Lock Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. There is an arrow in blue paint pointing to a chest."""

	[area.room.exits]
	north = { to = ".room.container", door = ".door.gate" }
	south = { to = ".room.unlock", door = ".door.unlock" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_lock"

	[[area.room.resets.item]]
	proto = ".item.training_chest"
	lock_prog = "tutorial_chest_lock"

# --- GET FROM CONTAINER ---
[[area.room]]
id = ".room.container"
name = "Indoc Container Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. There is an arrow in blue paint pointing to a chest."""

	[area.room.exits]
	north = { to = ".room.equip", door = ".door.gate" }
	south = { to = ".room.lock", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_container"

	[[area.room.resets.item]]
	proto = ".item.equipment_chest"
		[area.room.resets.item.contents]
		items = [".item.training_sword", ".item.leather_cap"]

# --- EQUIP ---
[[area.room]]
id = ".room.equip"
name = "Indoc Equip Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center."""

	[area.room.exits]
	north = { to = ".room.recovery", door = ".door.gate" }
	south = { to = ".room.container", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_equip"

# --- RECOVERY ---
[[area.room]]
id = ".room.recovery"
name = "Indoc Recovery Evaluation"
command_prog = "tutorial_recovery_command"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. A thin bedroll lies in one corner."""

	[area.room.exits]
	south = { to = ".room.equip", door = ".door.gate" }
	north = { to = ".room.attack", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_recovery"

# --- ATTACK ---
[[area.room]]
id = ".room.attack"
name = "Indoc Combat Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. From that circle is a yellow arrow pointing to a training dummy."""

	[area.room.exits]
	north = { to = ".room.flee", door = ".door.gate" }
	south = { to = ".room.recovery", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_attack"

	[[area.room.resets.mob]]
	proto = ".mob.training_dummy"
	player_attack_prog = "tutorial_dummy_combat_start"

# --- FLEE ---
[[area.room]]
id = ".room.flee"
name = "Indoc Flee Evaluation"
desc = """There is a circle painted on the floor in red paint. "INDUCTEE" has been stenciled in the center. From that circle is a yellow arrow pointing to a training dummy and two green arrows pointing to doors leading to the east and west."""

	[area.room.exits]
	north = { to = ".room.score", door = ".door.gate" }
	east = ".room.east_safe"
	west = ".room.west_safe"
	south = { to = ".room.attack", door = ".door.gate" }

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.facilitator_flee"

	[[area.room.resets.mob]]
	proto = ".mob.training_dummy_flee"
	player_attack_prog = "tutorial_flee_dummy_combat_start"
	player_flee_prog = "tutorial_flee_dummy_flee"

[[area.room]]
id = ".room.east_safe"
name = "East Safe Room"
desc = """This room is empty save for "SAFE" stenciled in large red lettering on the floor and an arrow pointing west."""

	[area.room.exits]
	west = ".room.flee"

[[area.room]]
id = ".room.west_safe"
name = "West Safe Room"
desc = """This room is empty save for "SAFE" stenciled in large red lettering on the floor and an arrow pointing east."""

	[area.room.exits]
	east = ".room.flee"

