	set_room_flag(room, 1)
	if get_room_flag(room, 0) then
		local facilitator = find_mob("tutorial.mob.facilitator_container")
		if facilitator and mob_in_room(facilitator, room) then
			emote(facilitator, "%s nods, unlocks, and opens the gate.")
