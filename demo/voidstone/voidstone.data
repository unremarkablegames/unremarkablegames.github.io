	hint("Some items can be worn or wielded. Try &!&eequip sword&g&* and &!&eequip cap&g&*.")
end

function tutorial_sword_equip(ctx)
	local room = get_room("tutorial.room.equip")
	set_room_flag(room, 0)
	if get_room_flag(room, 1) then
		local facilitator = find_mob("tutorial.mob.facilitator_equip")
		if facilitator and mob_in_room(facilitator, room) then
			emote(facilitator, "%s nods and unlocks the gate.")
		end
		unlock_door(room, "north")
		open_door(room, "north")
	end
end

function tutorial_cap_equip(ctx)
	local room = get_room("tutorial.room.equip")
	set_room_flag(room, 1)
	if get_room_flag(room, 0) then
		local facilitator = find_mob("tutorial.mob.facilitator_equip")
		if facilitator and mob_in_room(facilitator, room) then
			emote(facilitator, "%s nods and unlocks the gate.")
		end
		unlock_door(room, "north")
