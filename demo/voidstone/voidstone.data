# ==============================================================================
# ROOMS: Hall
# ==============================================================================

[[area.room]]
id = ".room.hall_s"
name = "South Corridor"
desc = """Stone corridor. Oil lamps hang from iron hooks. The air smells faintly of burning tallow."""

	[area.room.exits]
	east = ".room.hall_se"
	south = { to = ".room.cell_s", door = ".door.cell_s" }
	west = ".room.hall_sw"

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.guard_lead"

[[area.room]]
id = ".room.hall_se"
name = "Southeast Corridor"
desc = """Stone corridor. One lamp flickers, low on oil. Shadows shift on the walls."""

	[area.room.exits]
	north = ".room.hall_e"
	east = { to = ".room.cell_ese", door = ".door.cell_ese" }
	south = { to = ".room.cell_sse", door = ".door.cell_sse" }
	west = ".room.hall_s"

[[area.room]]
id = ".room.hall_e"
name = "East Corridor"
desc = """Stone corridor. Lamplight pools between the shadows. Somewhere, water drips."""

	[area.room.exits]
	north = ".room.hall_ne"
	east = { to = ".room.cell_e", door = ".door.cell_e" }
	south = ".room.hall_se"

[[area.room]]
id = ".room.hall_ne"
name = "Northeast Corridor"
desc = """Stone corridor. An empty hook on the wall, the lamp missing."""

	[area.room.exits]
	north = { to = ".room.cell_nne", door = ".door.cell_nne" }
	east = { to = ".room.cell_ene", door = ".door.cell_ene" }
	south = ".room.hall_e"
	west = ".room.hall_n"

[[area.room]]
id = ".room.hall_n"
name = "North Corridor"
desc = """Stone corridor. Oil lamps cast steady light. Boot prints scuff the flagstones."""

	[area.room.exits]
	north = { to = ".room.cell_n", door = ".door.cell_n" }
	east = ".room.hall_ne"
	west = ".room.hall_nw"

[[area.room]]
id = ".room.hall_nw"
name = "Northwest Corridor"
desc = """Stone corridor. The air is stale. Lamplight glints off the damp walls."""

	[area.room.exits]
	north = { to = ".room.cell_nnw", door = ".door.cell_nnw" }
	east = ".room.hall_n"
	south = ".room.hall_w"
	west = { to = ".room.cell_wnw", door = ".door.cell_wnw" }

[[area.room]]
id = ".room.hall_w"
name = "West Corridor"
desc = """Stone corridor. Oil lamps line the walls at even intervals."""

	[area.room.exits]
	north = ".room.hall_nw"
	south = ".room.hall_sw"
	east = ".room.hall_stair"

[[area.room]]
id = ".room.hall_sw"
name = "Southwest Corridor"
desc = """Stone corridor. A faint oil smell. The lamps have been recently filled."""

	[area.room.exits]
	north = ".room.hall_w"
	east = ".room.hall_s"
	south = { to = ".room.cell_ssw", door = ".door.cell_ssw" }
	west = { to = ".room.cell_wsw", door = ".door.cell_wsw" }

[[area.room]]
id = ".room.hall_stair"
name = "Dungeon Entrance"
desc = """A heavy timber ladder climbs twenty feet to an iron grate in the ceiling. Steel rods anchor it to the opening, each fitted with a pull-ring the guards can yank free without ever opening the grate. In the corner, a floor drain wider than the others. A rusted lock secures its cover."""

	[area.room.exits]
	west = ".room.hall_w"
	up = ".room.upper_dungeon"
	down = { to = ".room.sewer_entrance", door = ".door.sewer_entrance" }

# ==============================================================================
# ROOMS: Sewers
# ==============================================================================

[[area.room]]
id = ".room.sewer_entrance"
name = "Sewer Entrance"
desc = """The stench hits first. Rot, waste, wet mould. Water seeps down the walls, pooling in cracked stone. A trough runs through the center, carrying sluggish water and refuse. Rats scatter at your presence. The lamplight from above barely reaches."""

	[area.room.exits]
	up = { to = ".room.hall_stair", door = ".door.sewer_entrance" }
	north = ".room.sewer_n"
	east = ".room.sewer_e"
	south = ".room.sewer_s"
	west = ".room.sewer_w"

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.sewer_rat"

	[[area.room.resets.mob]]
	proto = ".mob.sewer_rat"

[[area.room]]
id = ".room.sewer_n"
name = "North Sewer"
desc = """The tunnel narrows here. Mould climbs the walls in dark patches."""

	[area.room.exits]
	east = ".room.sewer_ne"
	west = ".room.sewer_nw"
	south = ".room.sewer_entrance"

[[area.room]]
id = ".room.sewer_ne"
name = "Northeast Sewer"
desc = """A slow current carries refuse past your feet. Something pale floats by."""

	[area.room.exits]
	west = ".room.sewer_n"
	south = ".room.sewer_e"

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.sewer_rat"

[[area.room]]
id = ".room.sewer_e"
name = "East Sewer"
desc = """The ceiling drips. Puddles have formed between the cracked stones."""

	[area.room.exits]
	north = ".room.sewer_ne"
	west = ".room.sewer_entrance"
	south = ".room.sewer_se"

[[area.room]]
id = ".room.sewer_se"
name = "Southeast Sewer"
desc = """Rat droppings crunch underfoot. The smell is thicker here."""

	[area.room.exits]
	north = ".room.sewer_e"
	west = ".room.sewer_s"

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.sewer_rat"

[[area.room]]
id = ".room.sewer_s"
name = "South Sewer"
desc = """The water runs deeper here, ankle-high and cold."""

	[area.room.exits]
	north = ".room.sewer_entrance"
	east = ".room.sewer_se"
	west = ".room.sewer_sw"
	
[[area.room]]
id = ".room.sewer_sw"
name = "Southwest Sewer"
desc = """A collapsed section forces the trough into a wider pool. The water barely moves."""

	[area.room.exits]
	north = ".room.sewer_w"
	east = ".room.sewer_s"

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.sewer_rat"

[[area.room]]
id = ".room.sewer_w"
name = "West Sewer"
desc = """Roots have cracked through the stonework. The air is damp and close."""

	[area.room.exits]
	north = ".room.sewer_nw"
	east = ".room.sewer_entrance"
	south = ".room.sewer_sw"

[[area.room]]
id = ".room.sewer_nw"
name = "Northwest Sewer"
desc = """Water trickles somewhere ahead. The stones are slick. Every breath tastes of rot."""

	[area.room.exits]
	east = ".room.sewer_n"
	south = ".room.sewer_w"

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.sewer_rat"

# ==============================================================================
# ROOMS: Cell block
# ==============================================================================

[[area.room]]
id = ".room.cell_s"
name = "South Cell"
desc = """Iron bars form one wall. A wooden cot with fresh linens, a floor drain, bare stone scrubbed clean. Faint lye smell."""

can_leave_prog = "waking_cell_can_leave"

	[area.room.exits]
	north = { to = ".room.hall_s", door = ".door.cell_s" }

[[area.room]]
id = ".room.cell_sse"
name = "South-Southeast Cell"
desc = """Iron bars form one wall. A wooden cot, fresh linens folded at the foot. The stone floor gleams from scrubbing."""

	[area.room.exits]
	north = { to = ".room.hall_se", door = ".door.cell_sse" }

[[area.room]]
id = ".room.cell_ese"
name = "East-Southeast Cell"
desc = """Iron bars form one wall. A wooden cot, a water basin on a small table. The air smells of soap."""

	[area.room.exits]
	west = { to = ".room.hall_se", door = ".door.cell_ese" }

[[area.room]]
id = ".room.cell_e"
name = "East Cell"
desc = """Iron bars form one wall. A wooden cot. The linens are soaked through with blood."""

	[area.room.exits]
	west = { to = ".room.hall_e", door = ".door.cell_e" }

	[area.room.resets]
	[[area.room.resets.item]]
	proto = ".item.guard_corpse"
		[area.room.resets.item.contents]
		money = "7p"
		items = [".item.brass_key"]

	[[area.room.resets.item]]
	proto = ".item.candidate_corpse"

	[[area.room.resets.item]]
	proto = ".item.guard_spear"
		[area.room.resets.item.override]
		long_desc = "A spear, lodged deep into the corpse of the guard."
		pickup_msg = "You grab the spear and wrench it free. The squelching causes you to gag."

[[area.room]]
id = ".room.cell_ene"
name = "East-Northeast Cell"
desc = """Iron bars form one wall. A wooden cot with a thin blanket. A clay cup sits on the floor, empty."""

	[area.room.exits]
	west = { to = ".room.hall_ne", door = ".door.cell_ene" }

[[area.room]]
id = ".room.cell_nne"
name = "North-Northeast Cell"
desc = """Iron bars form one wall. A wooden cot, linens crisp and white. A chamber pot, emptied and cleaned."""

	[area.room.exits]
	south = { to = ".room.hall_ne", door = ".door.cell_nne" }

[[area.room]]
id = ".room.cell_n"
name = "North Cell"
desc = """Iron bars form one wall. A wooden cot, a folded towel. The stones are still damp from mopping."""

	[area.room.exits]
	south = { to = ".room.hall_n", door = ".door.cell_n" }

[[area.room]]
id = ".room.cell_nnw"
name = "North-Northwest Cell"
desc = """Iron bars form one wall. A wooden cot with fresh straw. The lye smell is sharp here."""

	[area.room.exits]
	south = { to = ".room.hall_nw", door = ".door.cell_nnw" }

[[area.room]]
id = ".room.cell_wnw"
name = "West-Northwest Cell"
desc = """Iron bars form one wall. A wooden cot, the blanket folded with military precision. Spotless."""

	[area.room.exits]
	east = { to = ".room.hall_nw", door = ".door.cell_wnw" }

[[area.room]]
id = ".room.cell_wsw"
name = "West-Southwest Cell"
desc = """Iron bars form one wall. A wooden cot. A small oil lamp hangs from a hook, unlit."""

	[area.room.exits]
	east = { to = ".room.hall_sw", door = ".door.cell_wsw" }

[[area.room]]
id = ".room.cell_ssw"
name = "South-Southwest Cell"
desc = """Iron bars form one wall. A wooden cot, linens tucked tight. The floor drain cover is polished brass."""

	[area.room.exits]
	north = { to = ".room.hall_sw", door = ".door.cell_ssw" }

# ==============================================================================
# ROOMS: upper dungeon
# ==============================================================================

[[area.room]]
id = ".room.upper_dungeon"
name = "Upper Dungeon"
desc = """Heavy iron bars partition the chamber into a checkpoint. A scarred oak desk sits before the gate, its surface worn smooth. Beyond the bars, murder holes pierce the ceiling. No dust on the crossbow mounts. The mechanisms are well oiled."""

	[area.room.exits]
	down = ".room.hall_stair"
	east = ".room.quartermaster"

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.guard"
	player_enter_prog = "upper_dungeon_guard_greet"

[[area.room]]
id = ".room.quartermaster"
name = "Quartermaster"
desc = """Heavy iron bars partition the chamber into a checkpoint. A scarred oak desk sits before the gate, its surface worn smooth. Beyond the bars, murder holes pierce the ceiling. No dust on the crossbow mounts. The mechanisms are well oiled."""

	[area.room.exits]
	west = ".room.upper_dungeon"

	[area.room.resets]
	[[area.room.resets.mob]]
	proto = ".mob.quartermaster"

