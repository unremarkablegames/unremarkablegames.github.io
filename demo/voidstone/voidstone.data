-- =============================================================================
-- RECOVERY ROOM
-- =============================================================================

function facilitator_recovery_greet(ctx)
	say(ctx.mob, "Facilitator Maren. You will need your strength for the next rooms. Sleep until you are refreshed.")
	hint("Rest recovers health and stamina. Try &!&esleep&g&* then &!&ewake&g&* when ready.")
end

function tutorial_recovery_command(ctx)
	if ctx.command ~= "wake" or not ctx.success then return end

	local hp = player_hp_percent()
	local sp = player_sp_percent()

	if hp < 100 or sp < 100 then
		hint("You are not fully refreshed. Try &!&esleep&g&* again.")
		return
	end

	local facilitator = find_mob("tutorial.mob.facilitator_recovery")
	if facilitator and mob_in_room(facilitator, ctx.room) then
		emote(facilitator, "%s nods, unlocks, then opens the gate.")
	end
	unlock_door(ctx.room, "north")
	open_door(ctx.room, "north")
end

-- =============================================================================
-- ATTACK ROOM
-- =============================================================================

function facilitator_attack_greet(ctx)
	say(ctx.mob, "Facilitator Dag. Hit the dummy. Don't hit yourself, it isn't funny.")
	hint("Enemies can be attacked. Try &!&ekill dummy&g&*.")
end

function tutorial_dummy_combat_start(ctx)
	local room = get_room("tutorial.room.attack")
	local facilitator = find_mob("tutorial.mob.facilitator_attack")
	if facilitator and mob_in_room(facilitator, room) then
		wait(2)
		say(facilitator, "Enough.")
		stop_combat()
		emote(facilitator, "%s unlocks and opens the gate.")
	end
	unlock_door(room, "north")
	open_door(room, "north")
end

-- =============================================================================
-- FLEE ROOM
-- =============================================================================

function facilitator_flee_greet(ctx)
	local room = get_room("tutorial.room.flee")
	local greeted = get_room_flag(room, 1)
	say(ctx.mob, "Hi. Facilitator Ylva. Attack the dummy, then run away. East or west, doesn't matter.")
	hint("Combat can be escaped. Try &!&ekill dummy&g&* then &!&eflee&g&*.")
	if not greeted then
		set_room_flag(room, 1)
		emote(ctx.mob, "%s shuts the door to the south.")
		close_door(room, "south")
	end
end

function tutorial_flee_dummy_combat_start(ctx)
	local room = get_room("tutorial.room.flee")
	set_room_flag(room, 0)
end

function tutorial_flee_dummy_flee(ctx)
	if not ctx.success then return end
	local room = get_room("tutorial.room.flee")
	if get_room_flag(room, 0) then
		local facilitator = find_mob("tutorial.mob.facilitator_flee")
		if facilitator and mob_in_room(facilitator, room) then
			say(facilitator, "Good.")
			emote(facilitator, "%s unlocks and opens the gate.")
		end
		unlock_door(room, "north")
		open_door(room, "north")
	end
end

