-- =============================================================================

function facilitator_target_greet(ctx)
	say(ctx.mob, "Good day. Facilitator Freya. There are two signs on the wall. Look at the second one.")
	hint("When multiple items share a name, use a number prefix. Try &!&elook 2.sign&g&*.")
end

function tutorial_second_sign_look(ctx)
	local room = get_room("tutorial.room.targeting")
	local facilitator = find_mob("tutorial.mob.facilitator_target")
	if facilitator and mob_in_room(facilitator, room) then
		emote(facilitator, "%s unlocks and opens the gate.")
	end
	unlock_door(room, "north")
	open_door(room, "north")
end

-- =============================================================================
-- HELP ROOM
-- =============================================================================

function facilitator_help_greet(ctx)
	say(ctx.mob, "I am Facilitator Liv. Use the help system. Look up any command you like.")
	hint("Documentation is available for all commands. Try &!&ehelp look&g&* or &!&ehelp&g&* for a list.")
end

function tutorial_help_command(ctx)
	if ctx.command ~= "help" or not ctx.success then return end
	local facilitator = find_mob("tutorial.mob.facilitator_help")
	if facilitator and mob_in_room(facilitator, ctx.room) then
		emote(facilitator, "%s closes her book, unlocks, then opens the gate.")
	end
	unlock_door(ctx.room, "north")
	open_door(ctx.room, "north")
end

-- =============================================================================
-- THE VOID
-- =============================================================================

function threshold_exit(ctx)
	if ctx.direction == "north" then
		write("You sense a momentary disorientation as your surroundings suddenly shift.")
	end
	return true
end

function keth_void_greet(ctx)
	say(ctx.mob, "You finished the tutorial. Good.")
	hint("Type &!&emenu&g&* to return to the main menu.")
	wait(6)
	emote(ctx.mob, "%s drops into his office chair.")
	wait(6)
	emote(ctx.mob, "%s reaches over and scratches the cat behind the ears.")
	wait(6)
	emote(ctx.mob, "%s takes out a pipe and a tobacco pouch.")
	wait(3)
	say(ctx.mob, "I played MUDs when I was a kid. Haven't logged into one in twenty years. They're mostly gone now.")
	wait(3)
	emote(ctx.mob, "%s starts loading the pipe.")
	wait(3)
	say(ctx.mob, "Still think about them, though.")
	wait(3)
	emote(ctx.mob, "%s tamps the pipe.")
	wait(3)
	emote(ctx.mob, "%s pats his pockets.")
	wait(3)
	emote(ctx.mob, "%s sets the pipe down on his desk.")
	wait(3)
	say(ctx.mob, "So I made this. The targeting room always confused people - came up in every playtest. Never could fix it. Shipped it anyway.")
	wait(8)
	say(ctx.mob, "Anyway, I hope this does well. But even if it doesn't... I needed to make it.")
	wait(5)
	say(ctx.mob, "Games aren't real until someone plays them.")
	wait(5)
	say(ctx.mob, "Thank you for making this real.")

	wait(10)
	return_to_menu()
end
[[system.item]]
id = "system.item.corpse"
keywords = "corpse body"
short = "a corpse"
long = "A corpse lies here."
desc = "It is dead."
type = "container"
capacity = "10st"
closeable = false
fixed = false
weight = "10st"

[[system.item]]
id = "system.item.money"
keywords = "coins money gold silver copper"
short = "some coins"
long = "Some coins lie here."
desc = "Currency of the realm."
type = "money"
weight = "1oz"
start_room = "induction.room.cell_s"
areas = [
	"areas/induction.toml",
	"areas/tutorial.toml"
]

[factions]
wildlife = { hostile_to = [] }
vermin = { hostile_to = [] }
player = { hostile_to = [] }
feral = { hostile_to = [] }

[player]
str = 10
dex = 10
int = 10
armor = 0
damage = 5
swordsmanship = 0
tactics = 0
anatomy = 0
wrestling = 0
starting_items = []

[combat]
unarmed_damage = 5
stamina_drain_per_move = 1
stamina_damage_threshold = 15

# Ticks to full heal (percentage-based regen)
# 0 = no regen, 600 = 1min, 1200 = 2min, 2400 = 4min
[regen]
hp_standing_ticks = 0
hp_resting_ticks = 2400
hp_sleeping_ticks = 1200
sp_standing_ticks = 2400
sp_resting_ticks = 1200
sp_sleeping_ticks = 600
