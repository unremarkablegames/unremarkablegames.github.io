# Help Topics
################################################################################

[[topic]]
id = "movement"
name = "Movement"
desc = "Type a direction to move: north, south, east, west, up, down. Abbreviations work too: n, s, e, w, u, d."
commands = []

[[topic]]
id = "combat"
name = "Combat"
desc = "Commands for fighting and fleeing."
commands = ["attack", "flee"]

[[topic]]
id = "interaction"
name = "Interaction"
desc = "Commands for interacting with objects and the world."
commands = ["look", "listen", "open", "close", "lock", "unlock", "get", "drop", "say", "shout"]

[[topic]]
id = "inventory"
name = "Inventory"
desc = "Commands for managing your belongings."
commands = ["inventory", "equip", "remove", "use", "from", "put"]

[[topic]]
id = "character"
name = "Character"
desc = "Commands for viewing and improving your character."
commands = ["stats", "skills", "quest", "raise", "meditate", "rest", "sleep", "wake"]

[[topic]]
id = "system"
name = "System"
desc = "Game system commands."
commands = ["help", "hint", "prompt", "colors", "worth", "save", "load", "quit"]

################################################################################
# Movement Commands
################################################################################

[[command]]
id = "move"
keywords = ["move", "north", "south", "east", "west", "up", "down"]
desc = """
Move in a direction using cardinal directions (north, south, east, west) or \
vertical (up, down). Single-letter shortcuts work: n, s, e, w, u, d."""

################################################################################
# Combat Commands
################################################################################

[[command]]
id = "attack"
keywords = ["attack", "kill"]
desc = """
Attack a mob in the room. Usage: attack <target>. Initiates combat with the \
target. Combat proceeds automatically until one combatant dies or you flee."""

[[command]]
id = "flee"
keywords = ["flee"]
desc = "Attempt to escape from combat. Ends your attack on the current target."

################################################################################
# Interaction Commands
################################################################################

[[command]]
id = "look"
keywords = ["look", "examine"]
desc = """
Examine the room or a specific target. Usage: look [target]. Without arguments, \
shows the room description, exits, and contents. With a target, examines that \
mob, item, or direction."""

[[command]]
id = "listen"
keywords = ["listen"]
desc = """
Listen to a mob in the room. Usage: listen <target>. Some mobs have things to \
say when you listen to them. Others have nothing interesting to share."""

[[command]]
id = "open"
keywords = ["open"]
desc = """
Open a door. Usage: open <door|direction>. Specify a direction (n, s, e, w, u, d) \
or 'door' to open the first closed door."""

[[command]]
id = "close"
keywords = ["close"]
desc = """
Close a door. Usage: close <door|direction>. Specify a direction (n, s, e, w, u, d) \
or 'door' to close the first open door."""

[[command]]
id = "lock"
keywords = ["lock"]
desc = """
Lock a closed door. Usage: lock <door|direction>. You must have the correct key \
in your inventory or equipped. The door must be closed first."""

[[command]]
id = "unlock"
keywords = ["unlock"]
desc = """
Unlock a locked door. Usage: unlock <door|direction>. You must have the correct \
key in your inventory or equipped."""

[[command]]
id = "get"
keywords = ["get", "take"]
desc = "Pick up an item from the ground. Usage: get <item>."

[[command]]
id = "drop"
keywords = ["drop"]
desc = "Drop an item from your inventory onto the ground. Usage: drop <item>."

[[command]]
id = "say"
keywords = ["say"]
desc = """
Speak to everyone in your current location. The ' character is a shortcut.

Usage: say <message>
       '<message>

Example:
  say hello there
  'hello there

See also: SHOUT"""

[[command]]
id = "shout"
keywords = ["shout"]
desc = """
Shout to adjacent rooms. Your voice carries through exits.

Usage: shout <message>

Example:
  shout hello

See also: SAY"""

################################################################################
# Inventory Commands
################################################################################

[[command]]
id = "inventory"
keywords = ["inventory"]
desc = "Display the items you are carrying."

[[command]]
id = "equip"
keywords = ["equip", "wield", "wear"]
desc = """
Equip an item from your inventory. Usage: equip <item>. Weapons are wielded, \
armor is worn. If a slot is occupied, the old item is automatically moved to \
inventory."""

[[command]]
id = "remove"
keywords = ["remove"]
desc = "Remove an equipped item and return it to your inventory. Usage: remove <item>."

[[command]]
id = "use"
keywords = ["use"]
desc = """
Use an item from your inventory or equipment. Usage: use <item>. Only items \
with special use effects can be activated this way."""

[[command]]
id = "from"
keywords = ["from"]
desc = """
Interact with containers. Get items from a container or put items into one.

Usage: from <container> get <item>
       from <container> get all
       from <container> put <item>

The container can be in the room or your inventory.

Example:
  from chest get sword    - Get sword from chest
  from chest get all      - Get everything from chest
  from bag put potion     - Put potion into bag

See also: GET, PUT"""

[[command]]
id = "put"
keywords = ["put"]
desc = """
Put an item from your inventory into a container.

Usage: put <item> <container>

Example:
  put sword chest         - Put sword into chest
  put potion bag          - Put potion into bag

See also: FROM, GET, DROP"""

################################################################################
# Character Commands
################################################################################

[[command]]
id = "stats"
keywords = ["stats", "score", "fragments"]
desc = """
Display your character sheet with stats, vitals, and equipment.

Shows:
- Name and fragment count
- Stats (STR/DEX/INT) as descriptive words (poor, average, good, etc.)
- HP condition (12 tiers: unharmed, scratched, lightly-wounded, wounded, badly-wounded, bloodied, mauled, severely-wounded, crippled, mortally-wounded, near-death, dead)
- SP condition (12 tiers: rested, fresh, barely-winded, winded, tired, weary, fatigued, severely-winded, exhausted, severely-exhausted, barely-conscious, collapsed)
- Armor/Damage descriptors
- Current position and carry weight
- Equipped items

Stat descriptors range from 'abysmal' (0) through 'poor' (20), 'average' (30), \
'good' (45), 'excellent' (60), up to 'mythic' (100)."""

[[command]]
id = "skills"
keywords = ["skills"]
desc = """
Display your skills with current values and caps.

Skills improve through use: combat actions trigger skill checks, and successful \
use slowly raises the skill toward its cap. Caps start at 50 and can be raised \
with the RAISE command.

See also: RAISE, STATS"""

[[command]]
id = "quest"
keywords = ["quest"]
desc = """
View your active and completed quests.

Usage: quest [done]

Without arguments, shows active quests grouped by type (main/side). Each quest \
displays its current objective. Use 'quest done' to see completed quests with \
their summaries.

Example:
  quest         - Show active quests
  quest done    - Show completed quests

See also: STATS"""

[[command]]
id = "meditate"
keywords = ["meditate"]
desc = """
Enter a meditative state to absorb fragments left behind by slain creatures. \
Meditation takes about 10 seconds. During this time you cannot move, fight, \
or take most actions. Being attacked will interrupt your meditation. \
Fragments are used with the RAISE command to increase stat and skill caps. \
See also: RAISE, STATS, SKILLS"""

[[command]]
id = "raise"
keywords = ["raise"]
desc = """
Spend fragments to raise your stat or skill cap by 10. Caps start at 50 (human \
maximum) and can be raised to 100 (Awakened maximum).

Usage: raise <stat|skill>

Stats: str, dex, int
Skills: swordsmanship, tactics, anatomy, wrestling

Fragment costs increase per tier: 16 (50â†’60), 32 (60â†’70), 64 (70â†’80), \
128 (80â†’90), 256 (90â†’100).

Raising caps does not increase your actual value. You still gain stats and \
skills through combat use.

See also: STATS, SKILLS, MEDITATE"""

[[command]]
id = "rest"
keywords = ["rest"]
desc = """
Sit down and rest. While resting you can use most commands but cannot move or \
fight. Standing happens automatically when you try to move or attack. \
See also: SLEEP, WAKE"""

[[command]]
id = "sleep"
keywords = ["sleep"]
desc = """
Lie down and sleep. While sleeping most commands are unavailable. Use WAKE \
to stand up. See also: REST, WAKE"""

[[command]]
id = "wake"
keywords = ["wake", "stand"]
desc = """
Stand up from sleeping, resting, or meditating. Alias: stand. \
See also: REST, SLEEP, MEDITATE"""

################################################################################
# System Commands
################################################################################

[[command]]
id = "help"
keywords = ["help"]
desc = """
Display help information. Usage: help [command|topic]. Without arguments, lists \
all topics. With a command name, shows detailed help. With a topic name, lists \
commands in that topic."""

[[command]]
id = "hint"
keywords = ["hint"]
desc = """
Toggle in-game hints on or off. Hints provide guidance for new players. \
Use this command to enable or disable them based on your preference."""

[[command]]
id = "prompt"
keywords = ["prompt"]
desc = """
View or customize your prompts. Two prompts: normal and combat (auto-switches when fighting). \
Usage: prompt [format|default] for normal, prompt combat [format|default] for combat. \
Without arguments, shows both current prompts. Format codes: %h (health), %s (stamina), \
%a (activity char), %S (activity word), %r (room name), %e (exits), \
%o (opponent name), %O (opponent condition), %% (literal %). \
Combat-only codes (%o, %O) expand to empty when not fighting."""

[[command]]
id = "colors"
keywords = ["colors"]
desc = "Display a test of the color palette."

[[command]]
id = "worth"
keywords = ["worth"]
desc = "Display how much money you are carrying."

[[command]]
id = "save"
keywords = ["save"]
desc = """
Save your game. Usage: save [name]. Without a name, saves to 'autosave'. \
Saves are stored in the saves/ directory."""

[[command]]
id = "load"
keywords = ["load"]
desc = """
Load a saved game. Usage: load [name]. Without a name, loads 'autosave'. \
If the world data has changed since the save, you'll be prompted to update."""

[[command]]
id = "quit"
keywords = ["quit"]
desc = "Exit the game. Automatically saves to 'autosave' before quitting."

################################################################################
# AI Bot Reference
################################################################################

[[command]]
id = "aibot"
keywords = ["aibot"]
desc = """
Complete command reference for AI/automated play.

MOVEMENT
  north (n)     - Move north
  south (s)     - Move south
  east (e)      - Move east
  west (w)      - Move west
  up (u)        - Move up
  down (d)      - Move down

INTERACTION
  look          - View room or examine target: look [target]
  examine       - Alias for look
  listen        - Listen to a mob: listen <target>
  open          - Open a door: open <direction|door>
  close         - Close a door: close <direction|door>
  lock          - Lock a closed door: lock <direction|door>
  unlock        - Unlock a locked door: unlock <direction|door>
  get           - Pick up item: get <item>
  take          - Alias for get
  drop          - Drop item: drop <item>
  say           - Speak to current room: say <message> or '<message>
  shout         - Shout to adjacent rooms: shout <message>

COMBAT
  attack        - Attack mob: attack <target>
  kill          - Alias for attack
  flee          - Escape combat

INVENTORY
  inventory     - List carried items
  equip         - Equip item: equip <item>
  wield         - Alias for equip (weapons)
  wear          - Alias for equip (armor)
  remove        - Unequip item: remove <item>
  use           - Use item: use <item>
  from          - Container access: from <container> get/put <item>
  put           - Put item in container: put <item> <container>

CHARACTER
  stats         - View character stats (HP, STR/DEX/INT, fragments)
  score         - Alias for stats
  fragments     - Alias for stats
  skills        - View skills with values and caps
  quest         - View quests: quest [done]
  quests        - Alias for quest
  raise         - Raise stat/skill cap: raise <stat|skill>
  meditate      - Absorb fragments from slain mobs (10 sec channel)
  rest          - Sit down and rest
  sleep         - Lie down and sleep
  wake          - Stand up (alias: stand)

SYSTEM
  help          - Show help: help [topic|command]
  hint          - Toggle hints on/off
  prompt        - View or set prompts: prompt [format|default], prompt combat [format|default]
  colors        - Display color palette test
  worth         - Show how much money you have
  save          - Save game: save [name]
  load          - Load game: load [name]
  quit          - Exit game (auto-saves)

WIZCOMMANDS
  !inspect      - Inspect entity: !inspect <self|room|area|mob|item>
  !lock         - Force lock door/container (no key needed): !lock <door|container>
  !quest        - Manipulate quest: !quest <reset|complete|start> <quest_id>
  !reload       - Reload world data (saves first)
  !set          - Modify player state: !set <category> <args>
  !spawn        - Spawn mob or item: !spawn <proto_id>
  !teleport     - Teleport to room or area: !teleport <room_id|area_id>
  !unlock       - Force unlock door/container: !unlock <door|container>
  !wipe         - Delete save and restart (requires confirmation)

SLASH COMMANDS
  /config font           - View or change font: /config font [number]
  /config font size      - View or change font size: /config font size [8-72]
  /config reset          - Reset config to defaults

TARGETING
  Use keywords from mob/item names. Example: 'attack rat' for 'giant rat'.
  For multiples, prefix with number: 'attack 2.rat' for second rat.

ABBREVIATIONS
  Commands can be abbreviated: 'l' for look, 'n' for north, 'i' for inventory.
  Parentheses above show common shortcuts."""
local Q_AWAKENING = "induction.main.awakening"

local function get_guard_state()
	if not quest_active(Q_AWAKENING) then return 0 end
	return quest_get(Q_AWAKENING, "guard_state") or 0
end

local function set_guard_state(state)
	if quest_active(Q_AWAKENING) then
		quest_set(Q_AWAKENING, "guard_state", state)
	end
end

-- =============================================================================
-- INTRO SEQUENCE
-- =============================================================================

function waking_cell_tick(ctx)
	if not ctx.mob then return end

	local waking_cell = get_room("induction.room.cell_s")
	if not player_in_room(waking_cell) then return end

	local state = get_guard_state()

	if state == 10 then return end

	if state == 0 then
		if sequence_active(ctx.mob) then return end
		if sequence_done(ctx.mob) then return end

		start_sequence(ctx.mob, function()
			wait(3)
			write("Metal on metal. A spear dragging across the bars of your cell.")
			wait(2)
			write("A stocky guard stands in the corridor, watching you through the iron.")
			wait(3)
			say_to(ctx.mob, waking_cell, "You awake?")
			wait(2)
			write("The spear thrusts through the bars. The tip stops an inch from your throat.")
			wait(2)
			emote_to(ctx.mob, waking_cell, "%s watches your eyes.")
			wait(3)
			write("The spear withdraws.")
			wait(2)
			say_to(ctx.mob, waking_cell, "Last one looked fine too.")
			wait(2)
			say_to(ctx.mob, waking_cell, "Don't move.")
			wait(2)
			write("Keys jangle. A lock clicks. The iron door swings open.")

			local hall = get_room("induction.room.hall_s")
			unlock_door(hall, "south")
			open_door(hall, "south")

			wait(1)
			move_mob(ctx.mob, waking_cell)
			emote(ctx.mob, "%s steps into the cell, spear leveled.")
			wait(3)
			emote(ctx.mob, "%s lowers the spear. Pulls out a clipboard.")
			wait(2)
			say(ctx.mob, string.format("Ah. %s.", player.name))
			wait(1)
			emote(ctx.mob, "%s checks the clipboard.")
			wait(2)
			say(ctx.mob, "You're on the list.")

			if not quest_active(Q_AWAKENING) and not quest_done(Q_AWAKENING) then
				quest_start(Q_AWAKENING, "Find the exit.")
			end

			wait(2)
			say(ctx.mob, "Quartermaster's up the ladder. Get your gear.")
			wait(1)
			emote(ctx.mob, "%s steps out of the cell.")
			move_mob(ctx.mob, hall)
			set_guard_state(10)
			hint("Type 'north' or 'n' to leave the cell.")
		end)
		return
	end
end

function waking_cell_can_leave(ctx)
	local guard = find_mob("induction.mob.guard_lead")
	if not guard then return true end

	local waking_cell = get_room("induction.room.cell_s")
	if mob_in_room(guard, waking_cell) then
		local state = get_guard_state()
		if state ~= 10 then
			emote(guard, "%s blocks your path.")
			say(guard, "Hold on. We're not done yet.")
			return false
		end
	end

	return true
end

-- =============================================================================
-- UPPER DUNGEON
-- =============================================================================

function upper_dungeon_guard_greet(ctx)
	local room = get_room("induction.room.upper_dungeon")
	if not is_first_visit(room) then return end

	emote(ctx.mob, "%s straightens up.")
	wait(1)
	say(ctx.mob, string.format("Awakened %s. Welcome up.", player.name))
	wait(2)
	say(ctx.mob, "Heard it was rough down there. Balak was a good man.")
end
sequences = {}
entity_data = {}
_current_entity = nil

function get_data(entity)
    if not entity_data[entity] then
        entity_data[entity] = {}
    end
    return entity_data[entity]
end

function deep_copy(t)
    if type(t) ~= "table" then return t end
    local copy = {}
    for k, v in pairs(t) do
        copy[k] = deep_copy(v)
    end
    return copy
end

function start_sequence(entity, func)
    if sequences[entity] then return false end 

    local co = coroutine.create(func)
    sequences[entity] = {co = co, wait = 0, done = false}

    local ok, wait_ticks = coroutine.resume(co)
    if ok and wait_ticks then
        sequences[entity].wait = wait_ticks
    elseif coroutine.status(co) == "dead" then
        sequences[entity].done = true
    end

    return true
end

function sequence_active(entity)
    local seq = sequences[entity]
    return seq ~= nil and not seq.done
end

function sequence_done(entity)
    local seq = sequences[entity]
    return seq ~= nil and seq.done
end

function wait(seconds)
    -- Auto-cancel any previous Lua-side sequence for this entity
    local entity = _current_entity
    if entity and sequences[entity] and sequences[entity].co ~= coroutine.running() then
        sequences[entity] = nil
    end

    local ticks = math.floor((seconds or 0.1) * TICKS_PER_SECOND + 0.5)
    if ticks < 1 then ticks = 1 end
    coroutine.yield(ticks)
end

function _tick_sequences()
    for entity, seq in pairs(sequences) do
        if seq.done then
        elseif seq.wait > 0 then
            seq.wait = seq.wait - 1
        elseif seq.wait == 0 then
            local ok, wait_ticks = coroutine.resume(seq.co)
            if ok and wait_ticks then
                seq.wait = wait_ticks
            end
            if coroutine.status(seq.co) == "dead" then
                seq.done = true
            end
        end
    end
end

function clear_sequence(entity)
    sequences[entity] = nil
end
-- =============================================================================
-- TUTORIAL: THE PROVING
-- Lua progs for the tutorial area
-- =============================================================================

-- =============================================================================
-- MOVEMENT ROOM
-- =============================================================================

function tutorial_movement_enter(ctx)
	hint("Directions move you. Try &!&enorth&g&* or &!&en&g&*. See &!&ehelp movement&g&* for more.")
end

local block_responses = {
	"Nothing back there for you, Inductee. Embrace your future.",
	"North or nothing, Inductee.",
	"The Stonewatcher owns you now, Inductee, and he wants you to complete indoc. Best remember that.",
	"You can cry all you want, Inductee. You're still gonna complete indoc.",
	"Don't want to be here, Inductee? Should have thought of that before you signed.",
	"You want to leave, Inductee? Here's the door... too bad you can't use it.",
	"For the love of Ren, it's only indoc.",
	"You are embarrassing yourself, Inductee."
}
local block_index = 0

function facilitator_enter_block(ctx)
	if ctx.direction == "north" then return true end

	local facilitator = find_mob("tutorial.mob.facilitator_induction")
	if facilitator then
		emote(facilitator, "%s blocks the door.")
		block_index = (block_index % #block_responses) + 1
		say(facilitator, block_responses[block_index])
	end
	return false
end

-- =============================================================================
-- LOOK ROOM
-- =============================================================================

function facilitator_look_greet(ctx)
	say(ctx.mob, "My name is Eira and I am going to evaluate observation. Examine the mark on the wall.")
	hint("Items can be examined. Try &!&elook mark&g&*.")
end

function tutorial_marker_look(ctx)
	local facilitator = find_mob("tutorial.mob.facilitator_look")
	if facilitator then
		emote(facilitator, "%s nods, unlocks, then opens the gate.")
	end
	local room = get_room("tutorial.room.look")
	unlock_door(room, "north")
	open_door(room, "north")
end

-- =============================================================================
-- SAY ROOM
-- =============================================================================

function facilitator_say_greet(ctx)
	say(ctx.mob, "My name is Facilitator Runa and I am here to evaluate your ability to speak. Say something, it doesn't matter what.")
	hint("Speech uses the say command. Try &!&esay hi&g&*.")
end

function facilitator_say_speech(ctx)
	local facilitator = find_mob("tutorial.mob.facilitator_say")
	if facilitator then
		emote(facilitator, "%s smiles, unlocks, then opens the gate.")
	end
	local room = get_room("tutorial.room.say")
	unlock_door(room, "north")
	open_door(room, "north")
end

-- =============================================================================
-- INVENTORY ROOM
-- =============================================================================

function facilitator_inventory_greet(ctx)
	say(ctx.mob, "I am Facilitator Torvin and I am going to evaluate your ability to check your inventory.")
	hint("The &!&einventory&g&* command shows what you're carrying.")
end

function tutorial_inventory_command(ctx)
	if ctx.command ~= "inventory" or not ctx.success then return end
	local facilitator = find_mob("tutorial.mob.facilitator_inventory")
	if facilitator and mob_in_room(facilitator, ctx.room) then
		emote(facilitator, "%s unlocks, then opens the gate.")
	end
	unlock_door(ctx.room, "north")
	open_door(ctx.room, "north")
end

-- =============================================================================
-- GET ROOM
-- =============================================================================

function facilitator_get_greet(ctx)
	say(ctx.mob, "Facilitator Haldr here and I am going to evaluate taking items. Get the candle.")
	hint("Items on the ground can be picked up. Try &!&eget candle&g&*.")
end

function tutorial_candle_pickup(ctx)
	local room = get_room("tutorial.room.get")
	local facilitator = find_mob("tutorial.mob.facilitator_get")
	if facilitator and mob_in_room(facilitator, room) then
		emote(facilitator, "%s unlocks and opens the gate.")
	end
	unlock_door(room, "north")
	open_door(room, "north")
end

-- =============================================================================
-- DROP ROOM
-- =============================================================================

function facilitator_drop_greet(ctx)
	say(ctx.mob, "My name is Thora and I am a facilitator here. I will be evaluating your ability to drop items. Please place the candle you picked up in the previous room on the floor.")
	hint("Items can be dropped from your inventory. Try &!&edrop candle&g&*.")
end

function tutorial_drop_room(ctx)
	if not item_is(ctx.item, "tutorial.item.candle") then return end
	local room = get_room("tutorial.room.drop")
	local facilitator = find_mob("tutorial.mob.facilitator_drop")
	if facilitator and mob_in_room(facilitator, room) then
		say(facilitator, "Thank you. You may proceed.")
		emote(facilitator, "%s unlocks and opens the gate.")
	end
	unlock_door(room, "north")
	open_door(room, "north")
end

-- =============================================================================
-- OPEN ROOM
-- =============================================================================

function facilitator_open_greet(ctx)
	say(ctx.mob, "Facilitator Sigrid. I will be evaluating basic door operation. Open the north door and proceed to the next room.")
	hint("Doors and containers can be opened. Try &!&eopen north&g&*. See &!&ehelp open&g&*.")

end

function facilitator_open_gate(ctx)
	if ctx.direction ~= "north" then return true end
	local facilitator = find_mob("tutorial.mob.facilitator_open")
	if facilitator then
		emote(facilitator, "%s smiles and motions you through.")
	end
	return true
end

-- =============================================================================
-- UNLOCK ROOM
-- =============================================================================

function facilitator_unlock_greet(ctx)
	say(ctx.mob, "I'm Facilitator Keld. I will be evaluating unlocking a locked door. The key is on the ground. Use the key to unlock the north door. Then open it and proceed to the next room.")
	hint("Locked doors require keys. Try &!&eget key&g&* then &!&eunlock north&g&*.")
end

function facilitator_unlock_gate(ctx)
	local facilitator = find_mob("tutorial.mob.facilitator_unlock")
	if facilitator then
		emote(facilitator, "%s smiles and motions you through.")
	end
end

-- =============================================================================
-- CLOSE ROOM
-- =============================================================================

function facilitator_close_greet(ctx)
	say(ctx.mob, "Facilitator Gunnar. Close the closet door.")
	hint("Open doors can be closed. Try &!&eclose west&g&*.")
end

function facilitator_close_gate(ctx)
	local room = get_room("tutorial.room.close")
	local facilitator = find_mob("tutorial.mob.facilitator_close")
	if facilitator and mob_in_room(facilitator, room) then
		emote(facilitator, "%s grunts approval, unlocks, and opens the gate.")
	end
	unlock_door(room, "north")
	open_door(room, "north")
end

-- =============================================================================
-- LOCK ROOM
-- =============================================================================

function facilitator_lock_greet(ctx)
	say(ctx.mob, "I am Facilitator Bjorn. You should still have the key. Lock the chest.")
	hint("Unlocked containers can be locked with a key. Try &!&elock chest&g&*.")
end

function tutorial_chest_lock(ctx)
	local room = get_room("tutorial.room.lock")
	local facilitator = find_mob("tutorial.mob.facilitator_lock")
	if facilitator and mob_in_room(facilitator, room) then
		emote(facilitator, "%s nods, unlocks, and opens the gate.")
		wait(1)
		emote(facilitator, "%s waves you through.")
	end
	unlock_door(room, "north")
	open_door(room, "north")
end

